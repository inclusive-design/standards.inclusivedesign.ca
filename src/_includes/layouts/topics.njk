{% extends "layouts/base.njk" %}

{% set pageType = 'topics' %}

{% block content %}
<nav aria-labelledby="topics-menu" class="flow sidebar-menu">
    <inclusive-disclosure>
        <button aria-controls="{{ title | slugify }}-menu">
            <h2 class="h3" id="topics-menu">{% __ 'toc' %}</h2>
        </button>
        <div content id="{{ title | slugify }}-menu">
            <ul role="list" class="flow">
                <li class="flow" id="toc">
                        <h3>{% __ 'toc' %}</h3>
                    <ul role="list" class="flow"></ul>
                </li>
            </ul>
        </div>
    </inclusive-disclosure>
</nav>
<article>
	{% set stages = collections['stages_' + lang] %}
	{% for stage in stages %}
	<section>
		<div class="wrapper flow">
			<h2>{{ stage.data.title }}</h2>
			{{ stage.content | safe }}
			<div class="cards">
				{% set topics = collections['topics_' + lang] | findAll('data.stage', stage.data.uuid) %}
				{% for topic in topics %}
					{% include 'partials/components/card--topic.njk' %}
				{% endfor %}
			</div>
		</div>
	</section>
	{% endfor %}

</article>
{% endblock %}
