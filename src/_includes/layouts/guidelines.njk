{% extends "layouts/base.njk" %}

{% set pageType = 'guidelines' %}

{% block content %}
<nav aria-labelledby="guidelines-menu" class="flow sidebar-menu">
    <h2 id="guidelines-menu">{% __ 'toc' %}</h2>
    <inclusive-disclosure>
        <button aria-controls="{{ title | slugify }}-menu">
            <h2 id="guidelines-menu-mobile" class="h3">{% __ 'toc' %}</h2>
        </button>
        <div content id="{{ title | slugify }}-menu">
            <div id="toc">
                <ul role="list" class="flow"></ul>
            </div>
        </div>
    </inclusive-disclosure>
</nav>
<article class="article flow">
{{ content | safe }}
{% set pieces = outro | renderContent('md') | split('<!-- search -->') %}
{{ pieces[0] | safe }}
{% include "partials/components/guidelines-search.njk" %}
{{ pieces [1] | safe }}
</article>
{% endblock %}
