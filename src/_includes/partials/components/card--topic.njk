{% set stage = collections['stages_' + lang] | find('data.uuid', topic.data.stage) %}
<div class="card topic bg-guidelines-stage-{{ stage.data.order }}" data-stage="{{ stage.data.order }}">
    <div class="card__fold"></div>
	<div class="card__content">
        <h3>
            <a class="card__title" href="{{ topic.url }}">
                {{ topic.data.title | safe }}
            </a>
        </h3>
        <p>
            {{ topic.data.description | safe }}
        </p>
		{% include '../../../_includes/svg/' + topic.data.translationKey + '.svg' %}
	</div>
</div>
